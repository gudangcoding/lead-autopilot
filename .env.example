# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=lead_autopilot

# App / Auth
APP_BASE_URL=http://localhost:3000
AUTH_SECRET=change-me-long-random
CRON_SECRET=change-me

# HCNSEC OpenAI-compatible LLM gateway (message generation / AI reply)
HCNSEC_BASE_URL=https://api.hcnsec.cn/v1
HCNSEC_API_KEY=sk-your-key
HCNSEC_MODEL=DeepSeek-V4-Pro

# SMTP (outbound email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=app-password
SMTP_FROM="Your Name <you@gmail.com>"

# IMAP (inbound email, optional - can also be set in Settings UI)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_ENABLED=false

# Baileys WhatsApp
WA_AUTH_DIR=./data/wa-auth
WA_DRY_RUN=true

# Scheduler
RUN_DAILY_ON_START=false

# Lead discovery (optional)
SERPAPI_KEY=
